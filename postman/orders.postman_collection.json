{
  "info": {
    "name": "Lab 5 - Orders API - Variant 2 - Zapletniuk",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "6 requests covering all 5 endpoints, including valid and invalid pagination. Start a fresh local server with npm start, then run all requests in order. The final request removes the order created by this run, so successful runs can be repeated. If a run was interrupted, restart the local server before repeating. No external services."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdOrder",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"Secret123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON Content-Type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const labResponse = pm.response.json();",
              "pm.test('Token received', () => pm.expect(labResponse.accessToken).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('token', labResponse.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create order",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"SKU-A\",\n      \"price\": 500,\n      \"qty\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON Content-Type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const labResponse = pm.response.json();",
              "pm.test('Total with delivery', () => pm.expect(labResponse.total).to.eql(560));",
              "pm.test('Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/orders/'+labResponse.id));",
              "pm.test('No ownerId', () => pm.expect(labResponse).not.to.have.property('ownerId'));",
              "pm.collectionVariables.set('orderId', labResponse.id);",
              "pm.collectionVariables.set('createdOrder', JSON.stringify(labResponse));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Get created order",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/orders/{{orderId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON Content-Type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const labResponse = pm.response.json();",
              "pm.test('Order persisted', () => pm.expect(labResponse).to.eql(JSON.parse(pm.collectionVariables.get('createdOrder'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Pagination valid",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/orders?limit=1&offset=0",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON Content-Type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const labResponse = pm.response.json();",
              "pm.test('One item on page', () => pm.expect(labResponse).to.have.lengthOf(1));",
              "pm.test('Page contains created order', () => pm.expect(labResponse[0]).to.eql(JSON.parse(pm.collectionVariables.get('createdOrder'))));",
              "pm.test('X-Total-Count is 1', () => pm.expect(pm.response.headers.get('X-Total-Count')).to.eql('1'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Pagination invalid",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/orders?limit=0&offset=0",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('JSON Content-Type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const labResponse = pm.response.json();",
              "pm.test('Invalid pagination', () => pm.expect(labResponse).to.eql({code:'INVALID_PAGINATION'}));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Delete order",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/orders/{{orderId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "pm.test('204 empty body', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ]
    }
  ]
}
