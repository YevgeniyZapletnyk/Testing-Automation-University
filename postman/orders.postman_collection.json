{
  "info": {
    "name": "Lab 5 - Orders API - Variant 2 - Zapletniuk",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the complete collection in order against the local lab server. It authenticates Bob/Alice, creates its own orders, tests pagination and all endpoints, then deletes only the orders created by this run. Start: npm start. Default baseUrl: http://127.0.0.1:3000."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "invalidToken",
      "value": "invalid-token",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "aliceToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "baseline",
      "value": "",
      "type": "string"
    },
    {
      "key": "secondOffset",
      "value": "",
      "type": "string"
    },
    {
      "key": "order1",
      "value": "",
      "type": "string"
    },
    {
      "key": "order2",
      "value": "",
      "type": "string"
    },
    {
      "key": "order3",
      "value": "",
      "type": "string"
    },
    {
      "key": "aliceOrder",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Login Bob",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"Secret123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON Content-Type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const labResponse = pm.response.json();",
              "pm.collectionVariables.set('token', labResponse.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login Alice",
