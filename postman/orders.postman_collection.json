        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON Content-Type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const labResponse = pm.response.json();",
              "pm.collectionVariables.set('baseline', Number(pm.response.headers.get('X-Total-Count')));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create Bob order 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"SKU-A\",\n      \"price\": 100,\n      \"qty\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON Content-Type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const labResponse = pm.response.json();",
              "pm.collectionVariables.set('order1', labResponse.id);",
              "pm.test('Total with delivery', () => { pm.expect(labResponse.total).to.eql(160); });",
              "pm.test('Location', () => { pm.expect(pm.response.headers.get('Location')).to.eql('/orders/'+labResponse.id); });",
              "pm.test('Internal field absent', () => { pm.expect(labResponse).not.to.have.property('ownerId'); });"
            ]
          }
        }
      ]
    },
